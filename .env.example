# Copy to .env.local and fill in real values. Never commit .env.local.
# See DEPLOYMENT.md § Environment Variables and SECURITY.md § Secrets.

# Safe to expose to the client — RLS is what actually protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Not needed for the MVP manual-UTR payment flow. Reserved for the future
# Razorpay gateway integration (ARCHITECTURE.md § 7).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
